# ==============================================================================
# EduTrack frontend — environment variables
# Copy to `.env` for local `npm run dev`. Not needed for the production build:
# in the monolith deployment the built assets are served by Spring Boot from
# the same origin, so VITE_API_BASE_URL can be omitted entirely (defaults to
# the relative "/api").
# ==============================================================================

# Only needed if you run the Vite dev server against a backend on a different
# host/port than the dev proxy in vite.config.js already points at.
# VITE_API_BASE_URL=http://localhost:8080/api
