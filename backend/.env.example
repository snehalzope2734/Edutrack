# ==============================================================================
# EduTrack backend — environment variables
# Copy to `.env` for local tooling, or set these directly in your shell /
# hosting provider's dashboard. NEVER commit a filled-in .env file.
#
# Local dev (application-dev.properties) has safe fallback defaults for
# everything except mail — the app will run without Cloudinary/Mongo/Mail
# creds, those features will just no-op or error only when actually used.
# Production (application-prod.properties) requires all of these to be set.
# ==============================================================================

# --- Active profile ---
SPRING_PROFILES_ACTIVE=dev
# use "prod" on a real deployment

# --- PostgreSQL (dev — any local Postgres 15+, e.g. `docker run -p 5432:5432 postgres:16`) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edutrack
DB_USER=postgres
DB_PASSWORD=postgres

# --- PostgreSQL (prod — Supabase) ---
# Get these from Supabase → Settings → Database → Connection string
SUPABASE_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres.xxxxxxxxxxxx
SUPABASE_PASSWORD=

# --- MongoDB Atlas (or local mongod for dev: mongodb://localhost:27017/edutrack) ---
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/edutrack?retryWrites=true&w=majority

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-secret-at-least-64-characters-long

# --- Cloudinary (file storage: profile photos, study materials, report cards) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Gmail SMTP shown; use an App Password, not your real password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=noreply@edutrack.school

# --- First-boot admin bootstrap ---
# There is no sign-up UI (no PUBLIC role) — on first boot, if no ADMIN account
# exists yet, one is created from these values. Change the password after first login.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@123
ADMIN_NAME=School Admin

# --- CORS / hosting (prod only) ---
# In the monolith deployment the frontend is served by this same Spring Boot
# app, so this is mostly a formality unless you also expose the API to an
# external caller.
CORS_ALLOWED_ORIGINS=http://localhost:8080
FRONTEND_URL=

# --- Server port (Render/Railway/etc. usually set PORT automatically) ---
PORT=8080

# --- Connection pool (prod) ---
DB_POOL_SIZE=10
